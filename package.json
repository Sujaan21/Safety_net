{
  "name": "safetynet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:cloudrun": "gcloud run deploy safetynet --source . --region us-central1 --allow-unauthenticated",
    "deploy:appengine": "npm run build && gcloud app deploy app.yaml",
    "deploy:firebase": "npm run build && npx firebase-tools deploy"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide": "^0.475.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "vite": "^6.1.0"
  }
}